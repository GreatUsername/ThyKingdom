# The same four days as skeleton.scn, computed with one-hour steps.
#
# Identical expected hash on purpose: growth is a function of the instant, not an
# accumulated total, so the step size must not matter at all.

[scenario]
seed = 1

[state]
start_day = 100
crops = 8
crop_rate = 1000

[run]
steps = 96
dt_us = 3600000000

[expect]
hash = 2449351277172351734

[growth]
m1 = 0
m2 = 0
m3 = 40
m4 = 80
m5 = 100
m6 = 100
m7 = 100
m8 = 100
m9 = -50
m10 = -100
m11 = -100
m12 = 0

[weather]
m1 = -500
m2 = -300
m3 = 200
m4 = 800
m5 = 1400
m6 = 1900
m7 = 2100
m8 = 1900
m9 = 1400
m10 = 800
m11 = 200
m12 = -300
