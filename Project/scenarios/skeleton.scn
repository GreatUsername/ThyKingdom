# Four days ending at the summer-to-autumn boundary: three days of growth, then
# one day of withering.
#
# The step is one second, so the boundary at day 181 falls in the middle of a step.
# That is the point: the system splits the step there, and the same span computed
# with hour-long steps must produce the same hash.

[scenario]
seed = 1

[state]
start_day = 178
crops = 8
crop_rate = 1000
wither_rate = 600

[run]
steps = 345600
dt_us = 1000000

[expect]
hash = 3842446313089821568
